PORT=3000
# Kunlik buyurtma raqami, ish vaqti va soatlik hisobot shu vaqt zonasida
TZ=Asia/Tashkent

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=nyff

# Kamida 32 belgili tasodifiy satr. Bo'sh qolsa birinchi ishga tushishda avtomatik yaratiladi (bazada saqlanadi).
JWT_SECRET=

# Ruxsat etilgan manbalar (vergul bilan). Bo'sh — hammasi (lokal tarmoq / ishlab chiqish uchun).
# CORS_ORIGIN=http://localhost:5173

# Bo'sh bazada (yangi server) birinchi ishga tushishda: admin admin@gmail.com / 123456789 va "Markaziy ombor"
# yaratiladi — qolganini admin panelda kiritasiz. Kirgach parolni "Profil" da almashtiring.

# 1 — filial online buyurtma olishi uchun kamida bitta kassa ekrani Socket.IO'ga ulangan bo'lishi shart.
# 0 — faqat smena va ish vaqti (frontend hali socket'ga ulanmagan paytda).
ONLINE_REQUIRE_KASSA=1
#Kwek mA BU WNCdsfdsfdssdf
# off — fon ishlari (5 daqiqalik qabul muddati) o'chiq. Testlar uchun.
# JOBS=off

# off — IP bo'yicha urinishlar chegarasi o'chiq (PIN bilan kirish, kiosk buyurtmasi, mobil buyurtma). Faqat testlar uchun.
# THROTTLE=off

# Proksi (Apache / nginx shu serverda) ortida mijozning haqiqiy IP si X-Forwarded-For dan. Bo'sh — loopback (faqat shu
# kompyuterdagi proksiga ishoniladi). off — o'chiq. Apache boshqa kompyuterda bo'lsa — uning IP si.
# TRUST_PROXY=loopback

# Taom / kategoriya rasmlari (`/images/products/...`, `/images/categories/...`), admin yuklaganlari ham shu yerga.
# Standart — backendning uploads papkasi (git'ga kirmaydi — `git pull` unga tegmaydi; papka bo'lmasa o'zi yaratiladi).
# Loyiha papkasini o'chirib qayta klonlasangiz yoki `git clean -fdx` qilsangiz — rasmlar ham o'chadi.
# Kategoriya ikonkalari — web ilovada (UI_DIST).
# IMAGES_DIR=uploads

# Oylik zaxira nusxa (Telegram botga) uchun pg_dump. Bo'sh — PATH dagisi; Windows'da PATH da bo'lmasa
# C:\Program Files\PostgreSQL\<eng yangi versiya>\bin\pg_dump.exe o'zi topiladi.
# PG_DUMP=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# Tayyor web ilova (`npm run build` → dist). Papka bo'lmasa UI berilmaydi, faqat API (ishlab chiqishda UI — Vite, 5173).
# UI_DIST=../ReactJS_NYFF/dist

# Xodimlar tizimi (kassa, oshxona, ombor, TV, kiosk, admin) shu yo'lda: newyork24.uz/shorva — domen ildizida emas.
# Web ilova ham shu yo'l bilan build qilinadi (ReactJS_NYFF: standart o'sha /shorva; boshqasi — UI_BASE=/... npm run build).
# UI_BASE=/shorva

# Domen ildizidagi sahifa (index.html) — hozircha vaqtinchalik bosh sahifa (logo). Standart — web ilovaning site papkasi.
# Serverda Apache o'zi beradi (/var/www/newyork24) — bu faqat Apache'siz ishlaganda kerak.
# SITE_DIR=../ReactJS_NYFF/site

# ── Milliy Ecom (NBU ekvayring) — test sahifasi /shorva/nbu/test (faqat admin) ──
# Bank faqat ro'yxatdan o'tgan server IP'sidan qabul qiladi — so'rovni shu backend yuboradi. Kalitlar faqat serverda
# (brauzerga ketmaydi). Test sahifasida vaqtincha almashtirsa ham bo'ladi (xotirada, restartgacha).
# NBU_BASE_URL=https://ecom.nbu.uz/epgate
# NBU_API_KEY=
# NBU_SECRET_KEY=
# NBU_USERNAME=
# NBU_PASSWORD=
# X-SIGNATURE kodlash: hex (standart) yoki base64 — bank 4007/4001 qaytarsa base64 ni sinang
# NBU_SIGNATURE_ENCODING=hex
# Kartani to'ldirish (/payment/credits, encryptedData) uchun bank bergan ochiq kalit (PEM yoki base64) va OAEP hash
# NBU_BANK_PUBLIC_KEY=
# NBU_OAEP_HASH=sha1